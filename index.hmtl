<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Type-First Brand Systems · Playbook · Vástago Design Studio</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,100..900&family=Fraunces:opsz,wght,SOFT,WONK@9..144,100..900,0..100,0..1&family=Literata:opsz,wght@7..72,300..700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{
  --blue:#002FFF; --yellow:#FEFF62; --ink:#000; --paper:#fff;
  --grey:#888; --line:#E6E6E6; --soft:#F5F5F3; --ink2:#2b2b2b;
  --r:10px; --wrap:780px; --wide:1120px;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{font-family:Inter,system-ui,sans-serif;font-optical-sizing:auto;font-weight:300;color:var(--ink);background:var(--paper);font-size:17px;line-height:1.6;-webkit-font-smoothing:antialiased}
a{color:inherit}
strong,b{font-weight:600}
::selection{background:var(--yellow)}

/* NAV */
.nav{position:sticky;top:0;z-index:50;background:var(--blue);color:#fff}
.nav-in{max-width:var(--wide);margin:0 auto;display:flex;align-items:center;gap:24px;padding:14px 20px}
.brand{font-size:19px;font-weight:300;letter-spacing:-.01em;white-space:nowrap;text-decoration:none}
.brand b{font-weight:700}
.toc{display:flex;gap:18px;overflow-x:auto;scrollbar-width:none;margin-left:auto;font-size:14px}
.toc::-webkit-scrollbar{display:none}
.toc a{text-decoration:none;white-space:nowrap;opacity:.72;transition:opacity .2s}
.toc a:hover,.toc a.on{opacity:1}
.toc a.on{text-decoration:underline;text-underline-offset:5px;text-decoration-thickness:1px}
.prog{height:3px;background:rgba(255,255,255,.18)}
.prog i{display:block;height:100%;width:0;background:var(--yellow);transition:width .15s linear}
@media(max-width:720px){.nav-in{flex-direction:column;align-items:flex-start;gap:8px;padding:12px 18px}.toc{margin-left:0;width:100%;font-size:13px;gap:16px}}

/* LAYOUT */
section{padding:96px 20px}
.wrap{max-width:var(--wrap);margin:0 auto}
.wide{max-width:var(--wide);margin:0 auto}
.dark{background:#000;color:#fff}
.tint{background:var(--soft)}
@media(max-width:720px){section{padding:64px 18px}}

/* TYPE */
.label{font-size:12.8px;letter-spacing:.4em;text-transform:uppercase;font-weight:400;color:var(--grey);margin-bottom:22px}
.dark .label{color:#9a9a9a}
h1,h2,h3{font-weight:600;letter-spacing:-.03em;line-height:1.05}
h1{font-size:clamp(40px,7.4vw,84px)}
h2{font-size:clamp(32px,5vw,52px);margin-bottom:22px}
h3{font-size:clamp(21px,2.6vw,26px);letter-spacing:-.02em;line-height:1.2;margin-bottom:10px}
.lead{font-size:clamp(19px,2.2vw,23px);line-height:1.45;color:var(--ink2);max-width:640px}
.dark .lead{color:#d9d9d9}
p+p{margin-top:16px}
.muted{color:var(--grey)}
.sm{font-size:14.5px}

/* BUTTONS */
.pill{display:inline-flex;align-items:center;gap:8px;background:var(--yellow);color:#000;text-decoration:none;font-weight:500;font-size:15px;padding:11px 20px 10px;border-radius:var(--r);border:0;cursor:pointer;font-family:inherit;transition:transform .15s}
.pill:hover{transform:translateY(-1px)}
.pill.dk{background:#000;color:#fff}
.dark .pill.dk{background:#fff;color:#000}

/* HERO */
.hero{min-height:calc(100vh - 54px);display:flex;align-items:center;text-align:center;position:relative;overflow:hidden;
  background:radial-gradient(ellipse 70% 45% at 50% 105%,rgba(0,47,255,.16),rgba(255,255,255,0) 70%)}
.hero .wrap{max-width:960px}
.hero h1{margin:6px 0 24px}
.hero .lead{margin:0 auto 34px}
.ficha{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line);border-radius:var(--r);overflow:hidden;margin:48px auto 0;max-width:640px;text-align:left}
.ficha div{background:#fff;padding:14px 16px}
.ficha span{display:block;font-size:11px;letter-spacing:.25em;text-transform:uppercase;color:var(--grey);margin-bottom:4px}
.ficha strong{font-weight:500;font-size:15px}
@media(max-width:560px){.ficha{grid-template-columns:1fr}}

/* MANIFESTO */
.mani p{font-size:clamp(20px,2.6vw,27px);line-height:1.42;font-weight:300;letter-spacing:-.01em}
.mani p+p{margin-top:26px}
.mani em{font-style:normal;background:var(--yellow);color:#000;padding:0 .18em}
.sign{margin-top:40px;font-size:14px;color:#9a9a9a;letter-spacing:.02em}

/* CARDS */
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
@media(max-width:860px){.grid2,.grid3{grid-template-columns:1fr}}
.card{background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:26px}
.tint .card{border-color:#e9e9e6}
.num{font-size:12.8px;letter-spacing:.4em;color:var(--blue);margin-bottom:12px;font-weight:500}
.fig{background:var(--soft);border-radius:8px;margin:14px 0 18px;padding:14px;display:flex;align-items:center;justify-content:center;min-height:150px;overflow:hidden}
.tint .fig{background:#fff;border:1px solid #ecece9}
.fig svg{width:100%;height:auto;max-height:170px}
.trio{display:grid;gap:12px;font-size:15px;line-height:1.55}
.trio div{padding-left:14px;border-left:2px solid var(--line)}
.trio b{display:block;font-size:11px;letter-spacing:.22em;text-transform:uppercase;font-weight:500;color:var(--grey);margin-bottom:2px}
.trio .bad{border-left-color:#ff5a36}
.trio .bad b{color:#d8401f}

/* SPECIMENS */
.spec-row{display:flex;align-items:baseline;justify-content:space-around;width:100%;gap:10px;flex-wrap:wrap}
.spec-row small{display:block;font-family:Inter;font-size:10.5px;letter-spacing:.15em;text-transform:uppercase;color:var(--grey);margin-top:6px;text-align:center}

/* AXIS */
.axis{margin:30px 0 8px}
.axis-bar{position:relative;height:2px;background:#000;margin:36px 8px 14px}
.axis-bar i{position:absolute;top:-6px;width:14px;height:14px;border-radius:50%;background:var(--blue);transform:translateX(-50%)}
.axis-bar i.y{background:var(--yellow);border:1px solid #000}
.axis-ends{display:flex;justify-content:space-between;font-size:14px;font-weight:500}
.steps{counter-reset:s;display:grid;gap:14px;margin-top:28px}
.steps li{list-style:none;counter-increment:s;display:grid;grid-template-columns:44px 1fr;gap:14px;padding:18px 0;border-top:1px solid var(--line)}
.steps li::before{content:counter(s,decimal-leading-zero);font-size:13px;letter-spacing:.2em;color:var(--blue);font-weight:500;padding-top:3px}
.steps h4{font-weight:600;font-size:17px;margin-bottom:4px;letter-spacing:-.01em}

/* DEMO slider */
.demo{border:1px solid var(--line);border-radius:var(--r);padding:26px;margin-top:34px;background:#fff}
.demo-word{font-family:Fraunces,serif;font-size:clamp(48px,10vw,108px);line-height:1;text-align:center;padding:18px 0 22px;letter-spacing:-.02em;transition:font-variation-settings .1s}
input[type=range]{width:100%;accent-color:var(--blue)}

/* PAIRING */
.pair{display:flex;flex-direction:column}
.pair .tag{display:inline-block;font-size:12px;letter-spacing:.1em;background:var(--yellow);padding:4px 10px 3px;border-radius:6px;font-weight:500;margin-bottom:14px;align-self:flex-start}
.pair .disp{font-size:44px;line-height:1;margin:6px 0 10px;letter-spacing:-.02em}
.pair .txt{font-size:15px;line-height:1.55;color:var(--ink2);padding-bottom:18px;border-bottom:1px solid var(--line);margin-bottom:16px}
.pair dl{display:grid;gap:10px;font-size:14.5px;line-height:1.5}
.pair dt{font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:var(--grey);font-weight:500}
.pair dd.err{color:#b8371a}

/* WORKSHEET */
.tool{background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:24px;margin:22px 0}
.ctrls{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:18px}
.ctrls label{font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--grey);display:flex;flex-direction:column;gap:6px;flex:1;min-width:140px}
select,.tool input[type=text],.tool input[type=number]{font-family:inherit;font-size:16px;padding:10px 12px;border:1px solid #d6d6d6;border-radius:8px;background:#fff;color:#000;font-weight:400;width:100%}
select:focus,input:focus,textarea:focus{outline:2px solid var(--blue);outline-offset:1px}
.scale-row{display:grid;grid-template-columns:110px 1fr 112px;gap:14px;align-items:baseline;padding:14px 0;border-top:1px solid var(--line)}
.scale-row .role{font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--grey)}
.scale-row .val{font-family:'IBM Plex Mono',monospace;font-size:12.5px;color:var(--grey);text-align:right;line-height:1.4}
.scale-row .smp{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
@media(max-width:640px){.scale-row{grid-template-columns:1fr;gap:4px}.scale-row .val{text-align:left}.scale-row .smp{white-space:normal}}
.wm{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--line);border-radius:8px;overflow:hidden;margin-top:6px}
.wm div{background:var(--soft);padding:26px 14px;text-align:center;overflow:hidden}
.wm .w{font-size:clamp(26px,5vw,44px);line-height:1;white-space:nowrap}
.wm small{display:block;font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--grey);margin-top:12px}
@media(max-width:640px){.wm{grid-template-columns:1fr}}
.rules{display:grid;gap:10px;margin-top:20px}
.rules li{list-style:none;padding-left:26px;position:relative;font-size:15.5px}
.rules li::before{content:"";position:absolute;left:0;top:9px;width:12px;height:2px;background:var(--blue)}

.mock{border:1px solid #e3e3e3;border-radius:8px;background:#fff;overflow:hidden;font-size:11px}
.mock.web .bar{background:var(--blue);color:#fff;padding:8px 10px;display:flex;justify-content:space-between;font-size:10px}
.roles{display:grid;gap:8px;margin-top:16px;font-size:14px}
.roles div{display:grid;grid-template-columns:72px 1fr;gap:10px}
.roles span{font-size:10.5px;letter-spacing:.18em;text-transform:uppercase;color:var(--blue);font-weight:500;padding-top:2px}

.check{display:grid;gap:0;margin-top:22px}
.ci{display:flex;gap:14px;align-items:flex-start;padding:16px 4px;border-top:1px solid var(--line);cursor:pointer;user-select:none}
.ci:last-child{border-bottom:1px solid var(--line)}
.box{width:22px;height:22px;border:1.5px solid #000;border-radius:6px;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:13px;margin-top:2px;transition:background .15s}
.ci.on .box{background:var(--yellow)}
.ci .q{font-size:16.5px;font-weight:400}
.ci .h{font-size:14px;color:var(--grey);margin-top:2px}
.meter{display:flex;align-items:center;gap:12px;margin-top:16px;font-size:13px;font-weight:500}
.meter .t{flex:1;height:4px;background:var(--line);border-radius:4px;overflow:hidden}
.meter .t i{display:block;height:100%;width:0;background:var(--blue);transition:width .25s}

/* LICENSES */
.lic{position:relative}
.lic .ext{font-family:'IBM Plex Mono',monospace;font-size:12px;color:var(--blue);margin-bottom:8px}
.lic dl{display:grid;gap:8px;font-size:14.5px;margin-top:12px}
.lic dt{font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--grey);font-weight:500}
.script{background:#000;color:#fff;border-radius:var(--r);padding:28px;margin-top:22px}
.script p{font-size:17px;line-height:1.6;color:#eaeaea}
.script .pill{margin-top:20px}
.dodont{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:22px}
.dodont ul{display:grid;gap:10px;margin-top:10px}
.dodont li{list-style:none;font-size:15px;padding-left:24px;position:relative}
.dodont .do li::before{content:"✓";position:absolute;left:0;color:var(--blue);font-weight:600}
.dodont .dont li::before{content:"×";position:absolute;left:2px;color:#d8401f;font-weight:600;font-size:17px;line-height:1.35}
@media(max-width:760px){.dodont{grid-template-columns:1fr}}
.note{border-left:3px solid var(--blue);padding:4px 0 4px 18px;margin-top:26px;font-size:15px;color:var(--ink2)}

/* RESOURCES */
.fdy{display:grid;grid-template-columns:auto 1fr auto;gap:18px;align-items:baseline;padding:20px 0;border-top:1px solid #222;text-decoration:none}
.fdy:last-child{border-bottom:1px solid #222}
.fdy .n{font-size:12px;letter-spacing:.3em;color:#777}
.fdy .t{font-size:clamp(22px,3vw,30px);font-weight:500;letter-spacing:-.02em;line-height:1.15}
.fdy .d{font-size:14.5px;color:#aaa;margin-top:4px;font-weight:300;letter-spacing:0}
.fdy .go{font-size:20px;transition:transform .2s}
.fdy:hover .go{transform:translateX(4px)}
.fdy:hover .t{color:var(--yellow)}
.refs{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:30px}
.refs a,.refs div{border:1px solid #2a2a2a;border-radius:var(--r);padding:18px;text-decoration:none;font-size:15px;color:#ddd}
.refs b{display:block;color:#fff;font-weight:500;margin-bottom:4px}
@media(max-width:700px){.refs{grid-template-columns:1fr}}

textarea{width:100%;min-height:220px;font-family:inherit;font-size:16px;line-height:1.6;padding:18px;border:1px solid #d6d6d6;border-radius:var(--r);resize:vertical;font-weight:300;background:#fff;
  background-image:repeating-linear-gradient(transparent 0 25px,#efefef 25px 26px);background-attachment:local;background-position:0 18px}

/* FOOTER */
footer{background:#000;color:#fff;padding:90px 20px 40px}
.f-big{font-size:clamp(30px,5vw,56px);font-weight:300;letter-spacing:-.03em;line-height:1.08;max-width:820px}
.f-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#222;border:1px solid #222;border-radius:var(--r);overflow:hidden;margin-top:44px}
.f-grid a{background:#000;padding:22px 20px;text-decoration:none;transition:background .2s}
.f-grid a:hover{background:#0b0b0b}
.f-grid span{display:block;font-size:11px;letter-spacing:.25em;text-transform:uppercase;color:#777;margin-bottom:8px}
.f-grid strong{font-weight:400;font-size:16px;word-break:break-word}
.f-grid a:hover strong{color:var(--yellow)}
@media(max-width:820px){.f-grid{grid-template-columns:1fr 1fr}}
@media(max-width:480px){.f-grid{grid-template-columns:1fr}}
.f-base{display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px;margin-top:60px;font-size:12.8px;color:#777}

.fade{opacity:0;transform:translateY(16px);transition:opacity .6s ease,transform .6s ease}
.fade.in{opacity:1;transform:none}
@media(prefers-reduced-motion:reduce){.fade{opacity:1;transform:none;transition:none}html{scroll-behavior:auto}}
@media print{.nav{position:static}.fade{opacity:1;transform:none}section{padding:40px 20px;break-inside:avoid-page}}
</style>
</head>
<body>

<header class="nav">
  <div class="nav-in">
    <a class="brand" href="#inicio"><b>Vástago</b> Design Studio</a>
    <nav class="toc" id="toc">
      <a href="#manifiesto">Manifiesto</a>
      <a href="#glosario">01 Glosario</a>
      <a href="#matriz">02 Matriz</a>
      <a href="#sprint">03 Sprint</a>
      <a href="#licencias">04 Licencias</a>
      <a href="#recursos">05 Recursos</a>
      <a href="#contacto">Contacto</a>
    </nav>
  </div>
  <div class="prog"><i id="prog"></i></div>
</header>

<!-- ═══════════ PORTADA ═══════════ -->
<section class="hero" id="inicio">
  <div class="wrap">
    <div class="label fade">Playbook</div>
    <h1 class="fade">Type-First Brand Systems</h1>
    <p class="lead fade">Identidades que duran una década, no una campaña. Una guía de trabajo para decidir con criterio tipográfico antes de dibujar un solo símbolo.</p>
    <a class="pill fade" href="#manifiesto">Empezar a leer ↓</a>
    <div class="ficha fade">
      <div><span>Nivel</span><strong>Intermedio</strong></div>
      <div><span>Edición</span><strong>2026 · Libre consulta</strong></div>
      <div><span>Autor</span><strong>Andrés Ramírez</strong></div>
    </div>
  </div>
</section>

<!-- ═══════════ MANIFIESTO ═══════════ -->
<section class="dark" id="manifiesto">
  <div class="wrap mani">
    <div class="label fade">00 · Manifiesto</div>
    <h2 class="fade" style="margin-bottom:44px">La tipografía como sistema operativo de la marca.</h2>
    <p class="fade">Un logotipo se ve una vez por pieza. La tipografía se lee en todas partes: en la factura, en el correo de bienvenida, en la etiqueta del producto, en la señalética, en el botón de pago. <em>Es la capa de la identidad que más trabaja</em> y, paradójicamente, la que menos tiempo recibe en el proceso de diseño.</p>
    <p class="fade">Las tendencias gráficas envejecen porque viven en la superficie: un degradado, un trazo, un efecto. Una decisión tipográfica sólida vive en la estructura: proporciones, ritmo, contraste, espaciado. Esa estructura no depende de la moda del año. Cuando la voz de una marca está codificada en sus letras, cualquier pieza nueva —hecha por cualquier persona del equipo— sigue sonando a la marca.</p>
    <p class="fade">Este taller propone invertir el orden habitual: primero la letra, después el símbolo, si es que hace falta. No como dogma estético, sino como decisión de sostenibilidad. Un sistema tipográfico bien construido reduce costos de producción, resiste los rediseños impulsivos y le devuelve al cliente algo que casi nunca recibe: <em>una identidad que puede operar sola.</em></p>
    <p class="sign fade">— Estudio Vástago</p>
  </div>
</section>

<!-- ═══════════ 01 GLOSARIO ═══════════ -->
<section class="tint" id="glosario">
  <div class="wide">
    <div class="wrap" style="margin:0 0 48px">
      <div class="label fade">01 · Glosario crítico</div>
      <h2 class="fade">Seis decisiones microtipográficas antes de elegir una fuente.</h2>
      <p class="lead fade">Antes de hablar de “estilo”, evalúa anatomía. Cada concepto incluye su definición, cómo afecta la voz de la marca y el síntoma visual que delata una mala elección.</p>
    </div>

    <div class="grid3">
      <!-- 1 x-height -->
      <article class="card fade">
        <div class="num">01</div>
        <h3>Altura de la x</h3>
        <div class="fig">
          <svg viewBox="0 0 300 150" aria-label="Diagrama de altura de la x">
            <line x1="0" y1="34" x2="300" y2="34" stroke="#bbb" stroke-dasharray="3 4"/>
            <line x1="0" y1="62" x2="300" y2="62" stroke="#002FFF" stroke-width="1.5"/>
            <line x1="0" y1="112" x2="300" y2="112" stroke="#000" stroke-width="1.5"/>
            <text x="24" y="112" font-family="Inter" font-weight="500" font-size="105" letter-spacing="-3">Hxg</text>
            <line x1="274" y1="62" x2="274" y2="112" stroke="#002FFF" stroke-width="1.5"/>
            <text x="230" y="56" font-family="Inter" font-size="11" fill="#002FFF">altura x</text>
            <text x="230" y="28" font-family="Inter" font-size="11" fill="#888">versal</text>
            <text x="230" y="130" font-family="Inter" font-size="11" fill="#000">línea base</text>
          </svg>
        </div>
        <div class="trio">
          <div><b>Definición</b>Distancia entre la línea base y la parte superior de las minúsculas sin ascendentes (x, a, e, o). Se mide en relación con la altura de versales o el cuerpo total.</div>
          <div><b>Voz de marca</b>Una x alta se percibe abierta, directa y legible a distancia; una x baja suena clásica, contenida y literaria.</div>
          <div class="bad"><b>Síntoma de mala elección</b>Textos legales y precios ilegibles a tamaños pequeños, o titulares que se ven “inflados” y sin elegancia en piezas premium.</div>
        </div>
      </article>

      <!-- 2 aperture -->
      <article class="card fade">
        <div class="num">02</div>
        <h3>Apertura de contraformas</h3>
        <div class="fig">
          <svg viewBox="0 0 300 150" aria-label="Apertura abierta frente a cerrada">
            <path d="M118 46 A42 42 0 1 0 118 104" fill="none" stroke="#000" stroke-width="15" stroke-linecap="butt"/>
            <path d="M262 58 A42 42 0 1 0 262 92" fill="none" stroke="#000" stroke-width="15" stroke-linecap="butt"/>
            <line x1="122" y1="44" x2="122" y2="106" stroke="#002FFF" stroke-width="1.5" stroke-dasharray="3 3"/>
            <line x1="266" y1="58" x2="266" y2="92" stroke="#ff5a36" stroke-width="1.5" stroke-dasharray="3 3"/>
            <text x="44" y="142" font-family="Inter" font-size="11" fill="#002FFF">abierta</text>
            <text x="190" y="142" font-family="Inter" font-size="11" fill="#d8401f">cerrada</text>
          </svg>
        </div>
        <div class="trio">
          <div><b>Definición</b>Grado en que los espacios internos parcialmente cerrados (en c, e, a, s) se abren hacia el exterior. Distingue a las humanistas (abiertas) de muchas grotescas (cerradas).</div>
          <div><b>Voz de marca</b>Apertura amplia transmite claridad, accesibilidad y calidez. Apertura cerrada se lee compacta, firme, mecánica o industrial.</div>
          <div class="bad"><b>Síntoma de mala elección</b>“c”, “e” y “o” se confunden en pantallas pequeñas o en señalética; la marca dice “cercana” y la letra dice “fábrica”.</div>
        </div>
      </article>

      <!-- 3 contrast -->
      <article class="card fade">
        <div class="num">03</div>
        <h3>Modulación y contraste de trazo</h3>
        <div class="fig">
          <svg viewBox="0 0 300 150" aria-label="Trazo monolineal frente a trazo con contraste">
            <ellipse cx="85" cy="72" rx="44" ry="50" fill="none" stroke="#000" stroke-width="13"/>
            <ellipse cx="220" cy="72" rx="50" ry="56" fill="#000"/>
            <ellipse cx="220" cy="72" rx="28" ry="52" fill="#F5F5F3"/>
            <line x1="220" y1="6" x2="220" y2="138" stroke="#002FFF" stroke-width="1" stroke-dasharray="3 3"/>
            <text x="42" y="146" font-family="Inter" font-size="11" fill="#888">monolineal</text>
            <text x="168" y="146" font-family="Inter" font-size="11" fill="#002FFF">contraste · eje vertical</text>
          </svg>
        </div>
        <div class="trio">
          <div><b>Definición</b>Diferencia de grosor entre trazos gruesos y finos, y el ángulo del eje en que se distribuye (oblicuo en humanistas, vertical en didonas).</div>
          <div><b>Voz de marca</b>Alto contraste: lujo, editorial, sofisticación. Bajo contraste: sobriedad, neutralidad técnica, robustez.</div>
          <div class="bad"><b>Síntoma de mala elección</b>Los filetes finos desaparecen en impresión pequeña, bordado, sellos o pantallas de baja densidad. La marca “se rompe” al reducirse.</div>
        </div>
      </article>

      <!-- 4 optical sizes -->
      <article class="card fade">
        <div class="num">04</div>
        <h3>Tamaños ópticos · Optical sizes</h3>
        <div class="fig" style="flex-direction:column">
          <div class="spec-row">
            <div><div style="font-family:Fraunces;font-size:52px;line-height:1;font-variation-settings:'opsz' 9,'wght' 400">Rara</div><small>opsz 9 · text</small></div>
            <div><div style="font-family:Fraunces;font-size:52px;line-height:1;font-variation-settings:'opsz' 144,'wght' 400">Rara</div><small>opsz 144 · display</small></div>
          </div>
        </div>
        <div class="trio">
          <div><b>Definición</b>Versiones de un mismo diseño ajustadas para un rango de tamaño: los cortes <i>text</i> tienen trazos más robustos, más espacio y x más alta; los <i>display</i>, más contraste y espaciado más ajustado.</div>
          <div><b>Voz de marca</b>Permite que la marca hable con la misma personalidad a 9 pt y a 9 metros sin perder precisión ni carácter.</div>
          <div class="bad"><b>Síntoma de mala elección</b>Un corte display en párrafos se ve frágil y apretado; un corte text en titulares se ve tosco y con huecos.</div>
        </div>
      </article>

      <!-- 5 weights -->
      <article class="card fade">
        <div class="num">05</div>
        <h3>Rango de pesos reales vs. deformados</h3>
        <div class="fig" style="flex-direction:column">
          <div class="spec-row">
            <div><div style="font-size:46px;line-height:1;font-weight:800;letter-spacing:-.02em">Rey</div><small>Bold real</small></div>
            <div><div style="font-size:46px;line-height:1;font-weight:400;-webkit-text-stroke:2.4px #000;letter-spacing:.01em">Rey</div><small style="color:#d8401f">Negrita falsa</small></div>
            <div><div style="font-size:46px;line-height:1;font-weight:400;transform:skewX(-12deg)">Rey</div><small style="color:#d8401f">Cursiva falsa</small></div>
          </div>
        </div>
        <div class="trio">
          <div><b>Definición</b>Pesos dibujados uno a uno (o interpolados en una variable) frente a pesos simulados por software: contorno engrosado, inclinación mecánica o escalado.</div>
          <div><b>Voz de marca</b>Una familia con rango real da jerarquía sin cambiar de voz. Los pesos sintéticos introducen un acento ajeno y barato.</div>
          <div class="bad"><b>Síntoma de mala elección</b>Contraformas que se cierran, curvas “empastadas”, cursivas que son romanas inclinadas y kerning que se rompe en negritas.</div>
        </div>
      </article>

      <!-- 6 tracking -->
      <article class="card fade">
        <div class="num">06</div>
        <h3>Interletrado / Tracking sistemático</h3>
        <div class="fig" style="flex-direction:column;align-items:stretch;gap:6px">
          <div style="display:flex;justify-content:space-between;align-items:baseline"><span style="font-size:40px;font-weight:600;letter-spacing:-.04em;line-height:1.1">Display</span><code style="font-family:'IBM Plex Mono';font-size:11px;color:#002FFF">−0.04em</code></div>
          <div style="display:flex;justify-content:space-between;align-items:baseline"><span style="font-size:17px;letter-spacing:0">Texto de lectura continua</span><code style="font-family:'IBM Plex Mono';font-size:11px;color:#002FFF">0</code></div>
          <div style="display:flex;justify-content:space-between;align-items:baseline"><span style="font-size:11px;letter-spacing:.3em;text-transform:uppercase">Metadato · versales</span><code style="font-family:'IBM Plex Mono';font-size:11px;color:#002FFF">+0.3em</code></div>
        </div>
        <div class="trio">
          <div><b>Definición</b>Ajuste uniforme del espacio entre todas las letras de un texto (a diferencia del kerning, que corrige pares específicos). “Sistemático” significa que depende del tamaño y la caja, no del gusto del día.</div>
          <div><b>Voz de marca</b>Apretado a gran tamaño: tensión, contemporaneidad. Abierto en versales pequeñas: calma, orden, lujo silencioso.</div>
          <div class="bad"><b>Síntoma de mala elección</b>Titulares que se ven “sueltos” y amateurs, minúsculas espaciadas que pierden la forma de palabra, cada pieza con un tracking distinto.</div>
        </div>
      </article>
    </div>
  </div>
</section>

<!-- ═══════════ 02 MATRIZ ═══════════ -->
<section id="matriz">
  <div class="wide">
    <div class="wrap" style="margin:0">
      <div class="label fade">02 · La matriz de tensión de marca</div>
      <h2 class="fade">Toda marca vive entre dos fuerzas. La tipografía decide hacia dónde se inclina.</h2>
      <p class="lead fade">Una identidad memorable no es neutra: sostiene una tensión. “Institucional pero humana”. “Técnica pero vernácula”. Nombrar esa tensión con precisión es lo que convierte la elección tipográfica en un argumento y no en un gusto.</p>

      <div class="axis fade">
        <div class="axis-bar"><i style="left:0%"></i><i class="y" style="left:66%"></i><i style="left:100%"></i></div>
        <div class="axis-ends"><span>Institucional</span><span class="muted sm">Posición del proyecto: 4 / 5</span><span>Humana</span></div>
      </div>

      <ol class="steps">
        <li class="fade"><div><h4>Extrae el vocabulario real</h4><p class="sm">De entrevistas, reseñas de clientes y documentos internos, anota los adjetivos que se repiten. Usa las palabras de la marca y de su público, no las del brief comercial.</p></div></li>
        <li class="fade"><div><h4>Agrupa en pares opuestos</h4><p class="sm">Convierte la lista en 3 a 5 ejes: institucional/humana, técnica/vernácula, editorial/accesible, precisa/cálida, local/global. Un eje solo es útil si ambos extremos son deseables.</p></div></li>
        <li class="fade"><div><h4>Elige una tensión dominante</h4><p class="sm">Solo una. Es la que el cliente no está dispuesto a perder en ninguno de los dos extremos. Las demás se resuelven con color, imagen o tono verbal.</p></div></li>
        <li class="fade"><div><h4>Ubica el proyecto en la escala 1–5</h4><p class="sm">Pide al cliente que marque dónde está hoy y dónde quiere estar en cinco años. La distancia entre ambos puntos es el trabajo de la identidad.</p></div></li>
        <li class="fade"><div><h4>Traduce a parámetros anatómicos</h4><p class="sm">Cada extremo se convierte en decisiones del glosario: contraste, apertura, altura de x, anchura, terminales, tracking. Escribe al menos dos parámetros por extremo.</p></div></li>
        <li class="fade"><div><h4>Prueba con palabras reales</h4><p class="sm">Compón el nombre, un titular, un precio y un párrafo legal del cliente. Nunca evalúes con “Lorem ipsum” ni con el nombre de la fuente.</p></div></li>
      </ol>

      <div class="demo fade">
        <div class="label" style="margin-bottom:6px">Prueba en vivo · desliza la tensión</div>
        <div class="demo-word" id="tword">Acacias</div>
        <input type="range" id="tension" min="0" max="100" value="35" aria-label="Tensión institucional a humana">
        <div class="axis-ends" style="margin-top:8px"><span>Institucional</span><span>Humana</span></div>
        <p class="sm muted" style="margin-top:12px">La misma familia (Fraunces, variable) se mueve en tres ejes a la vez: suavidad de terminales, peso y gesto. Así se ve una tensión traducida a anatomía.</p>
      </div>
    </div>

    <div class="wrap" style="margin:84px 0 32px">
      <div class="label fade">Pairing Matrix</div>
      <h2 class="fade" style="font-size:clamp(28px,4vw,40px)">Cuatro fórmulas de emparejamiento Display + Text.</h2>
      <p class="sm muted fade">Las fuentes de muestra son de licencia abierta para que puedas probarlas hoy. Entre paréntesis, equivalentes comerciales de referencia.</p>
    </div>

    <div class="grid2">
      <article class="card pair fade">
        <span class="tag">Institucional ↔ Humana</span>
        <div class="disp" style="font-family:Fraunces;font-variation-settings:'opsz' 144,'wght' 380,'SOFT' 100,'WONK' 0">Fundación</div>
        <p class="txt" style="font-family:Inter">Llevamos cuarenta años acompañando a familias rurales. Este informe resume lo que aprendimos y lo que aún nos falta.</p>
        <dl>
          <dt>Display</dt><dd>Serif transicional de contraste medio y terminales suaves (Fraunces SOFT alto · ref. Tiempos Headline).</dd>
          <dt>Text</dt><dd>Sans de apertura amplia y x alta, con optical size de texto (Inter · ref. Söhne).</dd>
          <dt>Razón estructural</dt><dd>El serif aporta memoria histórica y autoridad; la sans abierta sostiene la cercanía en la lectura larga. Sus alturas de x son próximas, así la mancha de texto convive sin saltos.</dd>
          <dt>Error común</dt><dd class="err">Elegir un serif tan rígido (didona dura) que la sans no alcanza a humanizarlo, o usar ambos en el mismo peso y tamaño: nadie lidera.</dd>
        </dl>
      </article>

      <article class="card pair fade">
        <span class="tag">Técnica ↔ Vernácula</span>
        <div class="disp" style="font-family:Inter;font-weight:850;letter-spacing:-.045em;text-transform:uppercase;font-variation-settings:'opsz' 32">Taller 07</div>
        <p class="txt" style="font-family:'IBM Plex Mono';font-size:13.5px">REF. 07-A · Tolerancia ±0,2 mm · Acero templado · Hecho a mano en Medellín.</p>
        <dl>
          <dt>Display</dt><dd>Grotesca de gran peso, ajustada y en versales, con gesto de rótulo popular (Inter Black · ref. tipos de rotulación local o custom).</dd>
          <dt>Text</dt><dd>Monoespaciada racional para datos, códigos y fichas técnicas (IBM Plex Mono · ref. Söhne Mono).</dd>
          <dt>Razón estructural</dt><dd>La masa del display trae la calle y el oficio; la mono trae medición y precisión. Comparten anatomía grotesca, así que el contraste está en el ritmo, no en el género.</dd>
          <dt>Error común</dt><dd class="err">Componer párrafos largos en mono (fatiga lectora) o acumular varios “gestos vernáculos” hasta caer en caricatura.</dd>
        </dl>
      </article>

      <article class="card pair fade">
        <span class="tag">Editorial ↔ Accesible</span>
        <div class="disp" style="font-family:Fraunces;font-variation-settings:'opsz' 144,'wght' 280,'SOFT' 0,'WONK' 1">Revista</div>
        <p class="txt" style="font-family:Literata;font-variation-settings:'opsz' 12;font-weight:400">Una buena página no se nota: se lee. El lector avanza sin tropezar y solo al final descubre cuánto disfrutó el camino.</p>
        <dl>
          <dt>Display</dt><dd>Serif de alto contraste en su corte display (Fraunces opsz 144 · ref. GT Super Display, Canela).</dd>
          <dt>Text</dt><dd>Serif de texto robusta, contraste bajo y optical size pequeño (Literata · ref. Tiempos Text).</dd>
          <dt>Razón estructural</dt><dd>Comparten lógica caligráfica (modulación, serifas), pero cada una está optimizada para su tamaño. Es el principio de la superfamilia: misma voz, distinta distancia.</dd>
          <dt>Error común</dt><dd class="err">Usar el corte display en cuerpo de texto porque “se ve más fino”: los filetes se rompen y la lectura cae.</dd>
        </dl>
      </article>

      <article class="card pair fade">
        <span class="tag">Precisa ↔ Cálida</span>
        <div class="disp" style="font-family:Inter;font-weight:600;letter-spacing:-.04em;font-variation-settings:'opsz' 32">Clínica Sur</div>
        <p class="txt" style="font-family:Literata;font-variation-settings:'opsz' 12;font-weight:400">Antes de su cita, le explicamos cada paso con calma. Si tiene preguntas, escríbanos: respondemos el mismo día.</p>
        <dl>
          <dt>Display</dt><dd>Neo-grotesca de peso medio con tracking negativo y optical size display (Inter Display · ref. Neue Haas Grotesk Display).</dd>
          <dt>Text</dt><dd>Serif humanista de texto con x generosa (Literata · ref. Freight Text).</dd>
          <dt>Razón estructural</dt><dd>El cambio de género (sans → serif) crea contraste evidente; proporciones y alturas de x compatibles evitan que la página se parta en dos voces.</dd>
          <dt>Error común</dt><dd class="err">Combinar una geométrica de x muy baja con una serif de x alta: la línea de texto se ve desnivelada y el sistema pierde unidad.</dd>
        </dl>
      </article>
    </div>
  </div>
</section>

<!-- ═══════════ 03 SPRINT ═══════════ -->
<section class="tint" id="sprint">
  <div class="wrap">
    <div class="label fade">03 · Hoja de trabajo del sprint</div>
    <h2 class="fade">Type-Only Brand System.</h2>
    <p class="lead fade">Diseña un sistema completo sin isotipos ni iconos. Si la marca funciona solo con letras, cualquier símbolo posterior será una suma, no un rescate.</p>

    <!-- Paso 1 -->
    <div style="margin-top:56px" class="fade">
      <div class="num">PASO 01</div>
      <h3>Configura la escala tipográfica funcional</h3>
      <p class="sm">Define un tamaño base para el cuerpo y una proporción. Cada rol se deriva de ahí, no de “lo que se vea bien” en cada pieza. Prueba combinaciones:</p>
    </div>
    <div class="tool fade">
      <div class="ctrls">
        <label>Tamaño base (px)<input type="number" id="base" value="17" min="12" max="24"></label>
        <label>Proporción
          <select id="ratio">
            <option value="1.2">1.200 · Tercera menor</option>
            <option value="1.25">1.250 · Tercera mayor</option>
            <option value="1.333" selected>1.333 · Cuarta justa</option>
            <option value="1.5">1.500 · Quinta justa</option>
            <option value="1.618">1.618 · Proporción áurea</option>
          </select>
        </label>
        <label>Texto de prueba<input type="text" id="sample" value="Granja Las Acacias"></label>
      </div>
      <div id="scale"></div>
      <p class="sm muted" style="margin-top:14px">Regla: a mayor tamaño, tracking más negativo e interlineado más cerrado. Proporciones bajas (1.2) sirven a interfaces densas; altas (1.5+) a marcas editoriales y afiches.</p>
    </div>

    <!-- Paso 2 -->
    <div style="margin-top:56px" class="fade">
      <div class="num">PASO 02</div>
      <h3>Construye el wordmark con ajustes ópticos</h3>
      <p class="sm">Escribe el nombre del proyecto y compara las dos cajas. Observa cómo cambia el espaciado necesario.</p>
    </div>
    <div class="tool fade">
      <div class="ctrls"><label>Nombre de la marca<input type="text" id="wmIn" value="Vástago" maxlength="24"></label></div>
      <div class="wm">
        <div><div class="w" id="wmUp" style="text-transform:uppercase;letter-spacing:.08em;font-weight:500">Vástago</div><small>Caja alta · tracking +0.08em</small></div>
        <div><div class="w" id="wmLo" style="letter-spacing:-.035em;font-weight:600">Vástago</div><small>Caja baja · tracking −0.035em</small></div>
      </div>
      <ul class="rules">
        <li><b>Caja alta pide aire.</b> Las versales se diseñan para ir junto a minúsculas; solas, se ven apretadas. Abre entre +0.04 y +0.12 em según el tamaño.</li>
        <li><b>Caja baja pide cierre.</b> A gran tamaño, el espaciado de fábrica (pensado para texto) se ve flojo. Cierra entre −0.02 y −0.05 em y revisa pares críticos.</li>
        <li><b>Espacia por área, no por distancia.</b> Ajusta pares como <i>LT, AV, ra, go</i> buscando volúmenes de blanco equivalentes, no medidas iguales entre bordes.</li>
        <li><b>Corrige a ojo, verifica invertido.</b> Revisa el wordmark al revés y en negativo: el cerebro deja de leer y empieza a ver ritmo.</li>
        <li><b>Diseña la jerarquía del nombre compuesto.</b> Si hay descriptor (“Design Studio”), defínelo como rol secundario: menor peso o menor tamaño, nunca ambos y nunca otro tracking arbitrario.</li>
        <li><b>Prueba en los extremos.</b> 16 px de ancho (favicon, sello) y 3 metros (fachada). Si falla en uno, necesitas una versión ajustada, no un logo nuevo.</li>
      </ul>
    </div>

    <!-- Paso 3 -->
    <div style="margin-top:56px" class="fade">
      <div class="num">PASO 03</div>
      <h3>Asigna roles tipográficos en soportes clave</h3>
      <p class="sm">Completa una hoja así para tu proyecto. Cada soporte usa los mismos roles; lo único que cambia es cuál domina.</p>
    </div>
    <div class="grid3" style="margin-top:22px">
      <div class="card fade" style="padding:18px">
        <div class="mock web">
          <div class="bar"><b>Marca</b><span>Menú · Menú · Menú</span></div>
          <div style="padding:16px 12px 18px">
            <div style="font-size:9px;letter-spacing:.3em;color:#888;text-transform:uppercase">Metadato</div>
            <div style="font-size:22px;font-weight:600;letter-spacing:-.03em;line-height:1.05;margin:6px 0">Titular principal</div>
            <div style="font-size:10px;color:#555;line-height:1.5">Cuerpo de apoyo breve en una o dos líneas.</div>
          </div>
        </div>
        <h3 style="font-size:18px;margin-top:16px">Cabecera web</h3>
        <div class="roles">
          <div><span>Domina</span>Display en titular; wordmark en barra.</div>
          <div><span>Apoya</span>Text en bajada, máx. 70 caracteres por línea.</div>
          <div><span>Ordena</span>Metadato en versales con tracking abierto.</div>
        </div>
      </div>
      <div class="card fade" style="padding:18px">
        <div class="mock" style="display:flex;gap:10px;padding:14px;background:#F5F5F3;justify-content:center">
          <div style="background:#fff;border:1px solid #ddd;width:44%;aspect-ratio:3/4;padding:8px;display:flex;flex-direction:column;justify-content:space-between">
            <div style="font-size:10px;font-weight:600;letter-spacing:.08em;text-transform:uppercase">Marca</div>
            <div style="font-size:6px;color:#666;line-height:1.5">Datos · Dirección<br>Correo · Web</div>
          </div>
          <div style="background:#fff;border:1px solid #ddd;width:38%;aspect-ratio:2/3;padding:8px;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center">
            <div style="font-size:13px;font-weight:600;letter-spacing:-.02em">Producto</div>
            <div style="font-size:5.5px;letter-spacing:.25em;margin-top:4px">250 G · LOTE 07</div>
          </div>
        </div>
        <h3 style="font-size:18px;margin-top:16px">Papelería / empaque</h3>
        <div class="roles">
          <div><span>Domina</span>Wordmark o nombre de producto.</div>
          <div><span>Apoya</span>Text en ingredientes, datos legales, firmas.</div>
          <div><span>Ordena</span>Metadato para lote, peso, referencia.</div>
        </div>
      </div>
      <div class="card fade" style="padding:18px">
        <div class="mock" style="background:#000;color:#fff;padding:14px;aspect-ratio:4/3;display:flex;flex-direction:column;justify-content:space-between">
          <div style="font-size:8px;letter-spacing:.3em">VÁSTAGO · 2026</div>
          <div style="font-size:32px;font-weight:700;letter-spacing:-.05em;line-height:.9">Letra<br>primero.</div>
          <div style="font-size:7px;color:#aaa">Charla abierta · Sábado 10 a.m.</div>
        </div>
        <h3 style="font-size:18px;margin-top:16px">Afiche editorial</h3>
        <div class="roles">
          <div><span>Domina</span>Display al máximo tamaño posible.</div>
          <div><span>Apoya</span>Text en datos de la convocatoria.</div>
          <div><span>Ordena</span>Metadato como firma y fecha.</div>
        </div>
      </div>
    </div>

    <!-- Checklist -->
    <div style="margin-top:64px" class="fade">
      <div class="num">CHECKLIST</div>
      <h3>Cinco preguntas de control antes de presentar</h3>
      <p class="sm">Si alguna respuesta es “no”, la identidad aún no está lista para el cliente.</p>
    </div>
    <div class="check fade" id="check"></div>
    <div class="meter fade"><div class="t"><i id="meterFill"></i></div><span id="meterTxt">0 / 5</span></div>
  </div>
</section>

<!-- ═══════════ 04 LICENCIAS ═══════════ -->
<section id="licencias">
  <div class="wide">
    <div class="wrap" style="margin:0 0 44px">
      <div class="label fade">04 · Guía operativa de licenciamiento</div>
      <h2 class="fade">Una fuente no se compra. Se licencia para un uso.</h2>
      <p class="lead fade">Cada fundidora define sus términos en su EULA (contrato de licencia de usuario final). Estas son las categorías estándar y lo que suelen cubrir. Antes de cotizar, lee siempre el EULA concreto.</p>
    </div>

    <div class="grid2">
      <article class="card lic fade">
        <div class="ext">.otf · .ttf</div>
        <h3>Desktop</h3>
        <p class="sm">Instalación en computadores para producir piezas estáticas.</p>
        <dl>
          <dt>Cubre</dt><dd>Impresos, imágenes, video, PDF y, en la mayoría de EULAs, el uso en logotipo convertido a contornos.</dd>
          <dt>Se mide por</dt><dd>Número de usuarios o equipos donde se instala.</dd>
          <dt>No cubre</dt><dd>Incrustar el archivo en una web o una app, ni compartirlo con terceros.</dd>
        </dl>
      </article>
      <article class="card lic fade">
        <div class="ext">.woff2</div>
        <h3>Webfont</h3>
        <p class="sm">Archivo optimizado para cargarse vía <code style="font-family:'IBM Plex Mono';font-size:13px">@font-face</code> en un sitio.</p>
        <dl>
          <dt>Cubre</dt><dd>Mostrar texto vivo en uno o varios dominios declarados.</dd>
          <dt>Se mide por</dt><dd>Páginas vistas mensuales o anuales, o por dominio, según la fundidora.</dd>
          <dt>No cubre</dt><dd>Usar el archivo en apps nativas ni en programas de escritorio.</dd>
        </dl>
      </article>
      <article class="card lic fade">
        <div class="ext">embebido en binario</div>
        <h3>App</h3>
        <p class="sm">La fuente viaja dentro de una aplicación móvil o de escritorio.</p>
        <dl>
          <dt>Cubre</dt><dd>Interfaz de una app específica en las plataformas acordadas.</dd>
          <dt>Se mide por</dt><dd>Número de apps o títulos; a veces por usuarios activos o descargas.</dd>
          <dt>No cubre</dt><dd>Otras apps del mismo cliente, ni que el usuario final exporte o edite con la fuente.</dd>
        </dl>
      </article>
      <article class="card lic fade" style="border-color:#000">
        <div class="ext">acuerdo a medida</div>
        <h3>Unlimited / Enterprise</h3>
        <p class="sm">Licencia corporativa negociada directamente con la fundidora.</p>
        <dl>
          <dt>Cubre</dt><dd>Todos o casi todos los medios y usuarios de la organización, a menudo filiales y agencias externas.</dd>
          <dt>Se mide por</dt><dd>Tamaño de la empresa y alcance; se cotiza caso a caso.</dd>
          <dt>Cuándo</dt><dd>Marcas con muchos equipos, proveedores y canales. Suele salir más económica que sumar licencias sueltas.</dd>
        </dl>
      </article>
    </div>

    <div class="wrap" style="margin:72px 0 0">
      <div class="num fade">CONVERSACIÓN CON EL CLIENTE</div>
      <h3 class="fade">Cómo explicar por qué las licencias se pagan aparte</h3>
      <p class="fade">Presenta la tipografía como un activo con dueño, igual que una fotografía de banco de imágenes o un software. La licencia debe quedar <b>a nombre del cliente</b> (el titular de la marca), no del estudio: así la identidad no depende de ti para seguir operando legalmente. Cotízala como línea separada, con el uso previsto por canal, para que el cliente vea que no es un margen escondido.</p>
      <div class="script fade">
        <div class="label" style="color:#9a9a9a;margin-bottom:12px">Guion sugerido</div>
        <p id="scriptTxt">“La tipografía de su marca es un software creado por una fundidora independiente. Mi honorario cubre el diseño del sistema; la licencia es el permiso legal para usar esas letras, y debe quedar a nombre de su empresa para que ustedes sean los titulares. La cotizamos por separado y según los canales que van a usar —impresos, web y app—, de modo que paguen solo lo que necesitan y puedan ampliarla cuando crezcan.”</p>
        <button class="pill" id="copyScript" type="button">Copiar guion</button>
      </div>
    </div>

    <div class="wrap" style="margin:72px 0 0">
      <div class="num fade">FASE DE PROPUESTA</div>
      <h3 class="fade">Manejo ético y seguro de fuentes de prueba (trials)</h3>
      <p class="fade">La mayoría de fundidoras ofrece trials para evaluar el diseño antes de comprar. Su uso está limitado por su propio EULA: en general permiten bocetar y presentar internamente, no publicar ni producir.</p>
      <div class="dodont fade">
        <div class="card do"><h3 style="font-size:18px">Sí</h3><ul>
          <li>Usar trials para bocetos y presentaciones de propuesta.</li>
          <li>Indicar en la presentación que las fuentes son de prueba y deben licenciarse.</li>
          <li>Incluir el costo estimado de licencias en la propuesta económica.</li>
          <li>Comprar la licencia a nombre del cliente al aprobarse la propuesta y antes de producir.</li>
          <li>Guardar en la carpeta del proyecto el EULA y el comprobante de compra.</li>
        </ul></div>
        <div class="card dont"><h3 style="font-size:18px">No</h3><ul>
          <li>Entregar archivos finales, artes de imprenta o webs con fuentes trial.</li>
          <li>Enviar los archivos de fuente al cliente o a un proveedor.</li>
          <li>Asumir que un trial incluye el set completo de caracteres o el kerning final: suele estar recortado.</li>
          <li>Usar tu licencia personal para producir piezas de un cliente.</li>
          <li>Convertir a contornos para “esquivar” la licencia.</li>
        </ul></div>
      </div>
      <p class="note fade">Esta guía es orientación operativa, no asesoría legal. Ante un caso dudoso (modificar glifos para un logotipo, uso en productos para reventa, transmisión televisiva), escribe directamente a la fundidora: la mayoría responde rápido y ofrece extensiones a medida.</p>
    </div>
  </div>
</section>

<!-- ═══════════ 05 RECURSOS ═══════════ -->
<section class="dark" id="recursos">
  <div class="wrap">
    <div class="label fade">05 · Recursos y criterio de estudio</div>
    <h2 class="fade">Cinco fundidoras independientes para afinar el ojo.</h2>
    <p class="lead fade" style="margin-bottom:40px">No para copiar estilos, sino para estudiar cómo resuelven familias completas: tamaños ópticos, rango de pesos, soporte de idiomas y documentación.</p>

    <a class="fdy fade" href="https://klim.co.nz" target="_blank" rel="noopener"><span class="n">01</span><div><div class="t">Klim Type Foundry</div><div class="d">Nueva Zelanda. Ensayos de diseño que explican el origen y la lógica de cada familia.</div></div><span class="go">↗</span></a>
    <a class="fdy fade" href="https://www.grillitype.com" target="_blank" rel="noopener"><span class="n">02</span><div><div class="t">Grilli Type</div><div class="d">Suiza. Grotescas contemporáneas con sistemas de cortes text y display muy rigurosos.</div></div><span class="go">↗</span></a>
    <a class="fdy fade" href="https://commercialtype.com" target="_blank" rel="noopener"><span class="n">03</span><div><div class="t">Commercial Type</div><div class="d">Nueva York y Londres. Referencia para tipografía editorial de alto contraste y superfamilias.</div></div><span class="go">↗</span></a>
    <a class="fdy fade" href="https://www.type-together.com" target="_blank" rel="noopener"><span class="n">04</span><div><div class="t">TypeTogether</div><div class="d">Fundidora independiente especializada en tipos para texto y en soporte multiescritura.</div></div><span class="go">↗</span></a>
    <a class="fdy fade" href="https://www.sudtipos.com" target="_blank" rel="noopener"><span class="n">05</span><div><div class="t">Sudtipos</div><div class="d">Argentina. Tipografía latinoamericana con oficio caligráfico; distribuidora del catálogo Vástago.</div></div><span class="go">↗</span></a>

    <div class="label fade" style="margin-top:60px">Referencias de consulta obligada</div>
    <div class="refs">
      <a class="fade" href="https://fontsinuse.com" target="_blank" rel="noopener"><b>Fonts In Use ↗</b>Archivo de tipografía aplicada en marcas reales, filtrable por fuente, industria y época.</a>
      <a class="fade" href="https://www.tiposlatinos.com" target="_blank" rel="noopener"><b>Bienal Tipos Latinos ↗</b>El panorama del diseño tipográfico latinoamericano, edición tras edición.</a>
      <div class="fade"><b>Robert Bringhurst</b><i>The Elements of Typographic Style.</i> La gramática de la composición de texto.</div>
      <div class="fade"><b>Ellen Lupton</b><i>Thinking with Type.</i> Letra, texto y retícula, explicados con ejemplos visuales.</div>
    </div>
  </div>
</section>

<!-- ═══════════ CIERRE ═══════════ -->
<section class="tint" id="cierre">
  <div class="wrap">
    <div class="label fade">06 · Ficha de cierre</div>
    <h2 class="fade">La letra es lenta. Por eso dura.</h2>
    <p class="lead fade">Tres horas alcanzan para cambiar el orden de tus decisiones, no para dominar el oficio. Ese dominio llega con repetición consciente: un wordmark a la semana, una escala por proyecto, un EULA leído completo antes de cada compra.</p>
    <div class="grid3" style="margin-top:36px">
      <div class="card fade"><div class="num">ESTA SEMANA</div><p class="sm">Rediseña un proyecto propio usando solo tipografía. Sin símbolo.</p></div>
      <div class="card fade"><div class="num">ESTE MES</div><p class="sm">Arma tu biblioteca de pairings probados con palabras reales de clientes.</p></div>
      <div class="card fade"><div class="num">ESTE AÑO</div><p class="sm">Presenta una identidad type-first completa a un cliente y documenta el resultado.</p></div>
    </div>
    <div style="margin-top:48px" class="fade">
      <div class="num">NOTAS DEL TALLERISTA</div>
      <textarea id="notes" placeholder="Escribe aquí tus aprendizajes, preguntas y decisiones. Se guardan en este navegador."></textarea>
      <p class="sm muted" style="margin-top:8px" id="notesState">Tus notas solo viven en este dispositivo.</p>
    </div>
  </div>
</section>

<!-- ═══════════ CONTACTO ═══════════ -->
<footer id="contacto">
  <div class="wide">
    <div class="label">Contacto</div>
    <p class="f-big">¿Tu marca necesita un sistema que dure? Hablemos con calma.</p>
    <div class="f-grid">
      <a href="mailto:hello@estudiovastago.com"><span>Correo</span><strong>hello@estudiovastago.com</strong></a>
      <a href="https://www.estudiovastago.com" target="_blank" rel="noopener"><span>Website</span><strong>estudiovastago.com ↗</strong></a>
      <a href="https://www.behance.net/vastago" target="_blank" rel="noopener"><span>Behance</span><strong>behance.net/vastago ↗</strong></a>
      <a href="https://www.instagram.com/estudiovastago/" target="_blank" rel="noopener"><span>Instagram</span><strong>@estudiovastago ↗</strong></a>
    </div>
    <div class="f-base">
      <span>Vástago Design Studio · Colombia</span>
      <span>Type-First Brand Systems · Playbook 2026 · Libre consulta</span>
    </div>
  </div>
</footer>

<script>
(function(){
  /* progress + active nav */
  var bar=document.getElementById('prog');
  var links=[].slice.call(document.querySelectorAll('#toc a'));
  function onScroll(){
    var h=document.documentElement;
    var p=h.scrollTop/(h.scrollHeight-h.clientHeight||1);
    bar.style.width=(p*100)+'%';
    var cur=null;
    links.forEach(function(a){var s=document.querySelector(a.getAttribute('href'));if(s&&s.getBoundingClientRect().top<140)cur=a;});
    links.forEach(function(a){a.classList.toggle('on',a===cur);});
    if(cur&&cur.scrollIntoView&&window.innerWidth<720){var t=document.getElementById('toc');t.scrollLeft=cur.offsetLeft-20;}
  }
  window.addEventListener('scroll',onScroll,{passive:true});onScroll();

  /* reveal */
  var els=document.querySelectorAll('.fade');
  if('IntersectionObserver' in window){
    var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}});},{rootMargin:'0px 0px -8% 0px'});
    els.forEach(function(e){io.observe(e);});
  } else els.forEach(function(e){e.classList.add('in');});

  /* tension demo */
  var tw=document.getElementById('tword'),tr=document.getElementById('tension');
  function tens(){var v=+tr.value/100;
    tw.style.fontVariationSettings="'opsz' 144,'wght' "+Math.round(620-v*320)+",'SOFT' "+Math.round(v*100)+",'WONK' "+(v>.6?1:0);
    tw.style.fontStyle='normal';}
  tr.addEventListener('input',tens);tens();

  /* scale */
  var roles=[
    {k:'Titular',e:4,w:600,ls:-.035,lh:1.05},
    {k:'Subtítulo',e:2,w:500,ls:-.015,lh:1.2},
    {k:'Cuerpo',e:0,w:400,ls:0,lh:1.55},
    {k:'Metadato',e:-1,w:500,ls:.25,lh:1.3,up:true}
  ];
  var base=document.getElementById('base'),ratio=document.getElementById('ratio'),sample=document.getElementById('sample'),out=document.getElementById('scale');
  function esc(s){return String(s).replace(/[&<>"]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];});}
  function scale(){
    var b=Math.min(28,Math.max(10,parseFloat(base.value)||17)),r=parseFloat(ratio.value),t=esc(sample.value||'Granja Las Acacias');
    out.innerHTML=roles.map(function(o){
      var px=b*Math.pow(r,o.e),disp=Math.min(px,window.innerWidth<640?44:72);
      return '<div class="scale-row"><div class="role">'+o.k+'</div><div class="smp" style="font-size:'+disp.toFixed(1)+'px;font-weight:'+o.w+';letter-spacing:'+o.ls+'em;line-height:'+o.lh+(o.up?';text-transform:uppercase':'')+'">'+t+'</div><div class="val">'+px.toFixed(1)+' px<br>'+(px/16).toFixed(3)+' rem · '+(o.ls>0?'+':'')+o.ls+'em</div></div>';
    }).join('');
  }
  [base,ratio,sample].forEach(function(el){el.addEventListener('input',scale);});
  window.addEventListener('resize',scale);scale();

  /* wordmark */
  var wi=document.getElementById('wmIn');
  wi.addEventListener('input',function(){var v=wi.value||'Vástago';document.getElementById('wmUp').textContent=v;document.getElementById('wmLo').textContent=v;});

  /* checklist */
  var Q=[
    ['¿La identidad se reconoce sin símbolo?','Tapa cualquier isotipo: si la marca desaparece, el sistema tipográfico aún no tiene voz propia.'],
    ['¿La tensión de marca es visible en la letra?','Debes poder señalar en la anatomía (contraste, apertura, tracking) dónde vive cada extremo.'],
    ['¿La escala funciona del favicon a la fachada?','Probada en 16 px y en gran formato, con palabras y datos reales del cliente.'],
    ['¿Otra persona puede aplicarla sin preguntarte?','Roles, tamaños, trackings e interlineados documentados como reglas, no como ejemplos.'],
    ['¿Las licencias están cotizadas y a nombre del cliente?','Canales definidos (desktop, web, app) y fuentes trial fuera de cualquier entregable.']
  ];
  var KEY='vastago-typefirst-check',st=[];
  try{st=JSON.parse(localStorage.getItem(KEY))||[];}catch(e){st=[];}
  var wrap=document.getElementById('check');
  function draw(){
    wrap.innerHTML='';
    Q.forEach(function(q,i){
      var on=st.indexOf(i)>-1,d=document.createElement('div');
      d.className='ci'+(on?' on':'');d.setAttribute('role','checkbox');d.setAttribute('aria-checked',on);d.tabIndex=0;
      d.innerHTML='<div class="box">'+(on?'✓':'')+'</div><div><div class="q">'+q[0]+'</div><div class="h">'+q[1]+'</div></div>';
      function tog(){var ix=st.indexOf(i);if(ix>-1)st.splice(ix,1);else st.push(i);try{localStorage.setItem(KEY,JSON.stringify(st));}catch(e){}draw();}
      d.onclick=tog;d.onkeydown=function(e){if(e.key===' '||e.key==='Enter'){e.preventDefault();tog();}};
      wrap.appendChild(d);
    });
    document.getElementById('meterFill').style.width=(st.length/Q.length*100)+'%';
    document.getElementById('meterTxt').textContent=st.length+' / '+Q.length+(st.length===Q.length?' · Lista para presentar':'');
  }
  draw();

  /* copy script */
  var cb=document.getElementById('copyScript');
  cb.addEventListener('click',function(){
    var txt=document.getElementById('scriptTxt').textContent.trim();
    function ok(){cb.textContent='Copiado ✓';setTimeout(function(){cb.textContent='Copiar guion';},2200);}
    function fb(){try{var ta=document.createElement('textarea');ta.value=txt;ta.style.position='fixed';ta.style.opacity='0';document.body.appendChild(ta);ta.select();document.execCommand('copy');ta.remove();ok();}catch(e){cb.textContent='Selecciona y copia el texto';}}
    try{navigator.clipboard.writeText(txt).then(ok,fb);}catch(e){fb();}
  });

  /* notes */
  var n=document.getElementById('notes'),ns=document.getElementById('notesState'),NK='vastago-typefirst-notes',tm;
  try{n.value=localStorage.getItem(NK)||'';}catch(e){}
  n.addEventListener('input',function(){clearTimeout(tm);tm=setTimeout(function(){try{localStorage.setItem(NK,n.value);ns.textContent='Guardado en este navegador.';}catch(e){ns.textContent='Este navegador no permite guardar notas; cópialas antes de salir.';}},400);});
})();
</script>
</body>
</html>
